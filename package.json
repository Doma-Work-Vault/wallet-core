{
  "name": "@bittasker/wallet-core",
  "version": "0.1.2",
  "description": "Multi-chain Bitcoin wallet SDK for RSK, BSC, Lightning swaps, Liquid swaps, and Submarine swaps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bitcoin",
    "wallet",
    "rsk",
    "rootstock",
    "bsc",
    "binance-smart-chain",
    "lightning",
    "lightning-network",
    "liquid",
    "liquid-network",
    "boltz",
    "atomic-swaps",
    "submarine-swaps",
    "reverse-swaps",
    "chain-swaps",
    "rif-relay",
    "gasless",
    "gasless-transactions",
    "typescript",
    "blockchain",
    "cryptocurrency",
    "defi",
    "web3",
    "ethereum",
    "smart-contracts",
    "hd-wallet",
    "bip39",
    "multi-chain"
  ],
  "author": "BitTasker Team <hello@bittasker.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bittasker/wallet-core.git"
  },
  "bugs": {
    "url": "https://gitlab.com/bittasker/wallet-core/-/issues"
  },
  "homepage": "https://gitlab.com/bittasker/wallet-core#readme",
  "dependencies": {
    "axios": "^1.8.4",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.0",
    "bolt11": "^1.4.1",
    "boltz-core": "^3.0.0",
    "ecpair": "^3.0.0",
    "ethers": "^6.15.0",
    "liquidjs-lib": "^6.0.2-liquid.37",
    "tiny-secp256k1": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
